e-run this only if you want to re-compare step counts, e.g. after changing the TTS model.","metadata":{}},{"id":"4698b3b2-8b49-4225-ac3c-9e51e799bc25","cell_type":"code","source":"from IPython.display import Audio, display\nimport time\n\n_text = \"የኢትዮጵያ ዋና ከተማ አዲስ አበባ ነው።\"\n_prev_step = NUM_STEP\nfor steps in (32, 16, 8):\n    NUM_STEP = steps\n    synth(_text)  # warmup\n    t = time.time()\n    a = synth(_text)\n    print(f\"num_step={steps}: {time.time()-t:.2f}s\")\n    display(Audio(a, rate=24000))\nNUM_STEP = _prev_step\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T20:08:07.867378Z","iopub.execute_input":"2026-10-06T20:08:07.867923Z","iopub.status.idle":"2026-10-06T20:08:13.947506Z","shell.execute_reply.started":"2026-10-06T20:08:07.867845Z","shell.execute_reply":"2026-10-06T20:08:13.946466Z"}},"outputs":[{"name":"stdout","text":"num_step=32: 1.65s\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.lib.display.Audio object>","text/html":"\n                <audio  controls=\"controls\" >\n                    <source src=\"data:audio/wav;base64,\" type=\"audio/wav\" />\n                    Your browser does not support the audio element.\n                </audio>\n              "},"metadata":{}},{"name":"stdout","text":"num_step=16: 0.91s\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.lib.display.Audio object>","text/html":"\n                <audio  controls=\"controls\" >\n                    <source src=\"data:audio/wav;base64,\" type=\"audio/wav\" />\n                    Your browser does not support the audio element.\n                </audio>\n              "},"metadata":{}},{"name":"stdout","text":"num_step=8: 0.48s\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.lib.display.Audio object>","text/html":"\n                <audio  controls=\"controls\" >\n                    <source src=\"data:audio/wav;base64,\" type=\"audio/wav\" />\n                    Your browser does not support the audio element.\n                </audio>\n              "},"metadata":{}}],"execution_count":28},{"id":"43a17a28-0411-4ea2-b60a-131f57c0d846","cell_type":"markdown","source":"## Section D — Extract the bank documents (RAG, step 1 of 2)\n\nReads every `.docx` under the `faq/` and `general/` folders of the attached `bank-docs` dataset, and splits each one into chunks at headings / question-style lines. Works for both FAQ-style (Q&A) documents and general policy-paragraph documents.","metadata":{}},{"id":"ce7735cf-8158-4a40-b1ac-e0e7b96dd2e9","cell_type":"code","source":"import os\nfor root, dirs, files in os.walk(\"/kaggle/input\"):\n    print(root, \"->\", dirs, files[:3])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:44:05.825525Z","iopub.execute_input":"2026-10-06T19:44:05.826063Z","iopub.status.idle":"2026-10-06T19:44:05.939832Z","shell.execute_reply.started":"2026-10-06T19:44:05.826036Z","shell.execute_reply":"2026-10-06T19:44:05.939178Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input -> ['datasets'] []\n/kaggle/input/datasets -> ['kibrewossentessera'] []\n/kaggle/input/datasets/kibrewossentessera -> ['bank-docsgeneral', 'bank-docsfaq'] []\n/kaggle/input/datasets/kibrewossentessera/bank-docsgeneral -> [] ['Moble banking feature Definition.docx', 'Appolo Product.docx', 'Bank Product conventional.pdf']\n/kaggle/input/datasets/kibrewossentessera/bank-docsfaq -> [] ['Mobile Bank Content Features.pdf', 'Appolo FAQ.docx', 'Bank Product FAQ.docx']\n","output_type":"stream"}],"execution_count":19},{"id":"146bfa37-61e4-4f45-8750-66e1a65a29d3","cell_type":"code","source":"!pip install -q python-docx\n\nimport glob, os, tarfile, zipfile\nfrom docx import Document\n\nRAW_PATH = \"/kaggle/input/datasets/natnaelweldeananiya/bank-docs\"\nINPUT_ROOT = \"/kaggle/input\"\nWORK_PATH = \"/kaggle/working/bank_docs_extracted\"\n\ndef show_tree(root, max_dirs=30):\n    n = 0\n    for dirpath, dirnames, filenames in os.walk(root):\n        depth = dirpath[len(root):].count(os.sep)\n        print(\"  \" * depth + (os.path.basename(dirpath) or dirpath) + \"/\")\n        for f in filenames[:5]:\n            print(\"  \" * (depth + 1) + f)\n        if len(filenames) > 5:\n            print(\"  \" * (depth + 1) + f\"... (+{len(filenames) - 5} more files)\")\n        n += 1\n        if n >= max_dirs:\n            print(\"  ...\")\n            break\n\nroot = RAW_PATH if os.path.exists(RAW_PATH) else INPUT_ROOT\nprint(\"searching under:\", root)\n\n# 1) extract archives only if nothing has been extracted yet\narchives = []\nfor pat in (\"*.tar.xz\", \"*.tar.gz\", \"*.tgz\", \"*.zip\"):\n    archives += glob.glob(f\"{root}/**/{pat}\", recursive=True)\nalready = glob.glob(f\"{WORK_PATH}/**/*.docx\", recursive=True)\nif archives and not already:\n    os.makedirs(WORK_PATH, exist_ok=True)\n    for arc in archives:\n        print(\"extracting:\", arc)\n        if arc.endswith(\".zip\"):\n            zipfile.ZipFile(arc).extractall(WORK_PATH)\n        else:\n            tarfile.open(arc).extractall(WORK_PATH)\nelif already:\n    print(f\"using the {len(already)} files already extracted in {WORK_PATH}\")\n\n# 2) find every .docx anywhere, skipping Word temp files and duplicates\nroots = [root] + ([WORK_PATH] if os.path.isdir(WORK_PATH) else [])\nseen, docx_files = set(), []\nfor r in roots:\n    for p in sorted(glob.glob(f\"{r}/**/*.docx\", recursive=True)):\n        key = (os.path.basename(p), os.path.getsize(p))\n        if os.path.basename(p).startswith(\"~$\") or key in seen:\n            continue\n        seen.add(key)\n        docx_files.append(p)\nold_doc = [p for r in roots for p in glob.glob(f\"{r}/**/*.doc\", recursive=True)]\nprint(f\"found {len(docx_files)} .docx files\")\nif old_doc:\n    print(f\"WARNING: {len(old_doc)} old .doc files were ignored; resave them as .docx\")\n\n# 3) split into chunks\ndef extract_chunks(path, category):\n    doc = Document(path)\n    chunks = []\n    current_title, current_body = None, []\n\n    def flush():\n        if current_title and current_body:\n            chunks.append({\"title\": current_title.strip(),\n                           \"text\": \" \".join(current_body).strip(),\n                           \"source\": os.path.basename(path), \"category\": category})\n\n    for para in doc.paragraphs:\n        text = para.text.strip()\n        if not text:\n            continue\n        is_heading = para.style.name.startswith(\"Heading\") or (text.endswith((\"?\", \"፧\")) and len(text) < 150)\n        if is_heading:\n            flush()\n            current_title, current_body = text, []\n        else:\n            current_body.append(text)\n    flush()\n\n    if not chunks:  # no headings found: keep the whole document (paragraphs, then tables)\n        full_text = \" \".join(p.text.strip() for p in doc.paragraphs if p.text.strip())\n        if not full_text:\n            cells = [c.text.strip() for t in doc.tables for row in t.rows for c in row.cells if c.text.strip()]\n            full_text = \" \".join(dict.fromkeys(cells))\n        if full_text:\n            chunks.append({\"title\": \"\", \"text\": full_text,\n                           \"source\": os.path.basename(path), \"category\": category})\n    return chunks\n\nfaq_items = []\nfor path in docx_files:\n    category = \"faq\" if \"faq\" in path.lower() else \"general\"\n    faq_items.extend(extract_chunks(path, category))\n\nfor cat in (\"faq\", \"general\"):\n    files = {c[\"source\"] for c in faq_items if c[\"category\"] == cat}\n    n = sum(1 for c in faq_items if c[\"category\"] == cat)\n    print(f\"{cat}: {len(files)} files -> {n} chunks\")\nprint(f\"\\nTotal chunks: {len(faq_items)}\")\n\nif not faq_items:\n    print(\"\\nNothing found. This is what the dataset contains:\")\n    show_tree(root)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:44:08.792059Z","iopub.execute_input":"2026-10-06T19:44:08.792358Z","iopub.status.idle":"2026-10-06T19:44:19.310413Z","shell.execute_reply.started":"2026-10-06T19:44:08.792335Z","shell.execute_reply":"2026-10-06T19:44:19.309646Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m253.0/253.0 kB\u001b[0m \u001b[31m7.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hsearching under: /kaggle/input\nfound 38 .docx files\nfaq: 20 files -> 540 chunks\ngeneral: 18 files -> 401 chunks\n\nTotal chunks: 941\n","output_type":"stream"}],"execution_count":20},{"id":"053d2b99-f327-4852-b352-bf3795a9a1c8","cell_type":"markdown","source":"## Section E — Build the retrieval index (RAG, step 2 of 2)\n\nEmbeds every chunk with BGE-M3 (open source, MIT license, supports Amharic), then `retrieve(query)` does a cosine-similarity search over those embeddings. At this scale (~1000 chunks) a plain numpy matrix multiply is instant — no vector database needed.","metadata":{}},{"id":"8cff2aac-da49-4001-9cdf-9184ade4ea6f","cell_type":"code","source":"!pip install -q -U FlagEmbedding\n\nfrom FlagEmbedding import BGEM3FlagModel\nimport numpy as np\n\nembedder = BGEM3FlagModel(\"BAAI/bge-m3\", use_fp16=True)\n\ntexts_to_embed = [f\"{c['title']} {c['text']}\" for c in faq_items]\nembeddings = embedder.encode(texts_to_embed, max_length=512, batch_size=12)[\"dense_vecs\"]\nembeddings = embeddings / np.linalg.norm(embeddings, axis=1, keepdims=True)\n\nnp.save(\"/kaggle/working/chunk_embeddings.npy\", embeddings)  # optional cache for reuse\nprint(f\"Embedded {len(faq_items)} chunks. Shape: {embeddings.shape}\")\n\ndef retrieve(query, top_k=3, min_score=0.35):\n    q_emb = embedder.encode([query], max_length=128)[\"dense_vecs\"][0]\n    q_emb = q_emb / np.linalg.norm(q_emb)\n    scores = embeddings @ q_emb\n    idx = np.argsort(-scores)[:top_k]\n    return [(faq_items[i], float(scores[i])) for i in idx if scores[i] >= min_score]\n\n# quick sanity check\nfor item, score in retrieve(\"የአፖሎ አካውንት ምንድን ነው\"):\n    print(f\"[{score:.2f}] {item['title']}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:44:19.312064Z","iopub.execute_input":"2026-10-06T19:44:19.312765Z","iopub.status.idle":"2026-10-06T19:45:23.394214Z","shell.execute_reply.started":"2026-10-06T19:44:19.312736Z","shell.execute_reply":"2026-10-06T19:45:23.393422Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m250.5/250.5 kB\u001b[0m \u001b[31m8.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m947.8/947.8 kB\u001b[0m \u001b[31m30.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m1.4/1.4 MB\u001b[0m \u001b[31m60.0 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25h","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/687 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ae4b08445e06400fa7c61e670597318e"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/444 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"32ed1446f8734c6ba0ad960345d3e5a9"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"sentencepiece.bpe.model: reconstructing file:   0%|          |  0.00B / 5.07MB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5e7bc9f6208e4a40ad9a3ed5f69f9654"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"sentencepiece.bpe.model: downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0