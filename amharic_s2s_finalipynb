not hits:\n        return \"ለዚህ ጥያቄ የሚዛመድ መረጃ አልተገኘም።\"\n    parts = []\n    for item, score in hits:\n        text = item[\"text\"]\n        if len(text) > max_chars_per_chunk:\n            text = text[:max_chars_per_chunk].rsplit(\" \", 1)[0] + \"...\"\n        parts.append(f\"{item['title']}\\n{text}\")\n    return \"\\n\\n\".join(parts)\n\ndef payload(user_text, stream=True, max_tokens=120):\n    context = build_context(user_text)\n    return {\n        \"messages\": [\n            {\"role\": \"system\", \"content\": BANK_SYSTEM},\n            {\"role\": \"system\", \"content\": f\"መረጃ፡\\n{context}\"},\n            {\"role\": \"user\", \"content\": user_text},\n        ],\n        \"stream\": stream,\n        \"max_tokens\": max_tokens,\n        \"temperature\": 0.2,\n        \"chat_template_kwargs\": {\"enable_thinking\": False},\n    }\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T20:00:22.932934Z","iopub.execute_input":"2026-10-06T20:00:22.933479Z","iopub.status.idle":"2026-10-06T20:00:22.94012Z","shell.execute_reply.started":"2026-10-06T20:00:22.933451Z","shell.execute_reply":"2026-10-06T20:00:22.939273Z"}},"outputs":[],"execution_count":24},{"id":"ef33ebe4-c5fd-4c89-b63f-7eddc0322172","cell_type":"code","source":"import requests\n\ndef test_answer(question):\n    r = requests.post(LLM_URL, json=payload(question, stream=False))\n    print(\"Q:\", question)\n    print(\"HTTP status:\", r.status_code)\n    data = r.json()\n    if \"choices\" in data:\n        print(\"A:\", data[\"choices\"][0][\"message\"][\"content\"])\n    else:\n        print(\"Server error:\", data)\n    print()\n\ntest_answer(\"የአፖሎ አካውንት ምንድን ነው\")\ntest_answer(\"የአውሮፕላን ትኬት መግዛት እፈልጋለሁ\")  # out of scope — should be refused, not invented\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T20:00:27.931035Z","iopub.execute_input":"2026-10-06T20:00:27.93174Z","iopub.status.idle":"2026-10-06T20:00:30.819506Z","shell.execute_reply.started":"2026-10-06T20:00:27.931711Z","shell.execute_reply":"2026-10-06T20:00:30.818814Z"}},"outputs":[{"name":"stderr","text":"Chunks: 100%|██████████| 1/1 [00:00<00:00,  9.02it/s]\n","output_type":"stream"},{"name":"stdout","text":"Q: የአፖሎ አካውንት ምንድን ነው\nHTTP status: 200\nA: አፖሎ 100% ዲጂታል የሆነ የባንክ አካውንት ሲሆን ወደ ባንክ ቅርንጫፍ በአካል መሄድ ሳያስፈልግዎ በስማርት ስልክዎ ብቻ የገንዘብ እንቅስቃሴዎን ሙሉ በሙሉ እንዲያስተዳድሩ የሚያስችልዎት ነው፡፡\n\n","output_type":"stream"},{"name":"stderr","text":"Chunks: 100%|██████████| 1/1 [00:00<00:00, 26.89it/s]\n","output_type":"stream"},{"name":"stdout","text":"Q: የአውሮፕላን ትኬት መግዛት እፈልጋለሁ\nHTTP status: 200\nA: ይህንን ጥያቄ መመለስ እንደማትችል በትህትና ተናገር።\n\n","output_type":"stream"}],"execution_count":25},{"id":"c69ceae9-0fed-40df-8eb0-aaccd52f5073","cell_type":"markdown","source":"Quick text-only check: one question that should be answered from the documents, one that should be politely refused.","metadata":{}},{"id":"daba7618-5856-46e9-a2c8-6edaba3eaf75","cell_type":"markdown","source":"## Section G — Full voice assistant\n\nMic → ASR → RAG-aware LLM (clause-chunked for low latency) → TTS → spoken answer, with a timing breakdown for each stage. `demo.launch(share=True)` prints a public `https://xxxxx.gradio.live` link — **open that link in a new browser tab** rather than using the embedded preview, or the microphone permission prompt will not appear.","metadata":{}},{"id":"1aa36caf-a195-4da8-baec-47192b99ce0c","cell_type":"code","source":"import json, re, numpy as np, time, requests, librosa, gradio as gr\n\nHARD = set(\"።፧!?\")\n\n# Dynamic in-memory audio cache for FAQ answer chunks to skip TTS\nAUDIO_CACHE = {}\n\ndef clean(t):\n    return re.sub(r\"\\s+([።፧፣፤!?])\", r\"\\1\", t).strip()\n\ndef llm_stream(user_text):\n    \"\"\"Streams the RAG-aware answer (uses payload() from Section F).\"\"\"\n    with requests.post(LLM_URL, json=payload(user_text, stream=True), stream=True) as r:\n        for line in r.iter_lines():\n            if not line.startswith(b\"data: \"):\n                continue\n            data = line[6:]\n            if data == b\"[DONE]\":\n                break\n            piece = json.loads(data)[\"choices\"][0][\"delta\"].get(\"content\") or \"\"\n            if piece:\n                yield piece\n\ndef run_pipeline(audio_path):\n    if audio_path is None:\n        return \"\", \"\", None, \"no audio\"\n\n    wav, _ = librosa.load(audio_path, sr=16000, mono=True)\n    audio_sec = len(wav) / 16000\n\n    t = time.perf_counter()\n    text = transcribe(wav)\n    t_asr = time.perf_counter() - t\n    if not text:\n        return \"(nothing recognised)\", \"\", None, f\"ASR {t_asr:.2f}s, empty transcript\"\n\n    t = time.perf_counter()\n    buf, t_first = \"\", None\n    for piece in llm_stream(text):\n        buf += piece\n        s = buf.rstrip()\n        if t_first is None and s and s[-1] in HARD and len(s.split()) >= 3:\n            t_first = time.perf_counter() - t\n    t_llm_total = time.perf_counter() - t\n    t_first = t_first if t_first is not None else t_llm_total\n    answer = clean(buf)\n\n    chunks = [c for c in re.split(r\"(?<=[።፧!?])\\s*\", answer) if c.strip()] or [answer]\n    parts, t_tts_first = [], None\n    \n    for i, ch in enumerate(chunks):\n        t_step = time.perf_counter()\n        \n        # Audio Cache Check\n        if ch in AUDIO_CACHE:\n            audio_chunk = AUDIO_CACHE[ch]\n            is_cached = True\n        else:\n            audio_chunk = synth(ch)\n            AUDIO_CACHE[ch] = audio_chunk\n            is_cached = False\n            \n        parts.append(audio_chunk)\n        \n        if i == 0:\n            t_tts_first = time.perf_counter() - t_step\n            cache_status = \"[CACHED HIT]\" if is_cached else \"[TTS RUN]\"\n            print(f\"First chunk {cache_status} in {t_tts_first:.2f}s\")\n            \n        parts.append(np.zeros(int(24000 * 0.12), dtype=np.float32))  # small gap between chunks\n        \n    audio_out = np.concatenate(parts)\n\n    audio_out = np.clip(audio_out, -1.0, 1.0)\n    audio_out = (audio_out * 32767).astype(np.int16)\n    \n    est = t_asr + t_first + t_tts_first\n    timings = (\n        f\"your speech: {audio_sec:.1f}s\\n\"\n        f\"ASR: {t_asr:.2f}s\\n\"\n        f\"LLM first clause: {t_first:.2f}s (whole answer {t_llm_total:.2f}s)\\n\"\n        f\"TTS first chunk: {t_tts_first:.2f}s (cached={ch in AUDIO_CACHE})\\n\"\n        f\"ESTIMATED time to first audio after you stop speaking: {est:.2f}s\\n\"\n        f\"(Cached chunks total: {len(AUDIO_CACHE)})\"\n    )\n    return text, answer, (24000, audio_out), timings\n\nwith gr.Blocks() as demo:\n    gr.Markdown(\"## Amharic bank voice assistant: speak, then press Stop\")\n    mic = gr.Audio(sources=[\"microphone\", \"upload\"], type=\"filepath\", label=\"Microphone\")\n    box_asr = gr.Textbox(label=\"You said (ASR)\")\n    box_ans = gr.Textbox(label=\"Assistant answer\")\n    out = gr.Audio(label=\"Spoken answer\", type=\"numpy\", autoplay=True)\n    box_t = gr.Textbox(label=\"Timings\", lines=6)\n    mic.stop_recording(run_pipeline, mic, [box_asr, box_ans, out, box_t])\n    mic.clear(lambda: (\"\", \"\", None, \"\"), outputs=[box_asr, box_ans, out, box_t])\n\n\ndemo.launch(share=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T20:08:23.219417Z","iopub.execute_input":"2026-10-06T20:08:23.220462Z","iopub.status.idle":"2026-10-06T20:08:24.826258Z","shell.execute_reply.started":"2026-10-06T20:08:23.220423Z","shell.execute_reply":"2026-10-06T20:08:24.825341Z"}},"outputs":[{"name":"stdout","text":"* Running on local URL:  http://127.0.0.1:7862\n* Running on public URL: https://38e06021591ef4a7cd.gradio.live\n\nThis share link is temporary and will last for up to 1 week (best effort). For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<div><iframe src=\"https://38e06021591ef4a7cd.gradio.live\" width=\"100%\" height=\"500\" allow=\"autoplay; camera; microphone; clipboard-read; clipboard-write;\" frameborder=\"0\" allowfullscreen></iframe></div>"},"metadata":{}},{"execution_count":29,"output_type":"execute_result","data":{"text/plain":""},"metadata":{}},{"name":"stderr","text":"Chunks: 100%|██████████| 1/1 [00:00<00:00, 20.51it/s]\n","output_type":"stream"},{"name":"stdout","text":"First chunk [TTS RUN] in 1.78s\n","output_type":"stream"},{"name":"stderr","text":"Chunks: 100%|██████████| 1/1 [00:00<00:00, 27.39it/s]\n","output_type":"stream"},{"name":"stdout","text":"First chunk [TTS RUN] in 8.91s\n","output_type":"stream"}],"execution_count":29},{"id":"a5434da0-828b-4563-9706-9df32be2eb4f","cell_type":"markdown","source":"## Section H — (Optional) OpenAI-compatible HTTP backend\n\nNot required for the Gradio demo above (which calls `transcribe`/`synth` directly). Exposes the local ASR and TTS as `/v1/audio/transcriptions` and `/v1/audio/speech` endpoints, matching the OpenAI API shape — useful later if you integrate this into Pipecat, which expects services in that shape.","metadata":{}},{"id":"b9cc9c3f-b55d-4dc9-ac0b-3ef50149918b","cell_type":"code","source":"import io, threading, uvicorn\nimport soundfile as sf\nfrom fastapi import FastAPI, File, Form, UploadFile\nfrom fastapi.responses import Response\nfrom pydantic import BaseModel\n\napp = FastAPI()\nasr_lock, tts_lock = threading.Lock(), threading.Lock()\n\n@app.get(\"/health\")\ndef health():\n    return {\"ok\": True}\n\n@app.post(\"/v1/audio/transcriptions\")\ndef transcriptions(file: UploadFile = File(...), model: str = Form(None), language: str = Form(None)):\n    data = file.file.read()\n    wav, sr = sf.read(io.BytesIO(data), dtype=\"float32\")\n    if wav.ndim > 1:\n        wav = wav.mean(axis=1)\n    if sr != 16000:\n        wav = librosa.resample(wav, orig_sr=sr, target_sr=16000)\n    with asr_lock:\n        text = transcribe(wav).strip()\n    return {\"text\": text}\n\nclass SpeechRequest(BaseModel):\n    model: str | None = None\n    input: str\n    voice: str | None = None\n    response_format: str | None = \"pcm\"\n    speed: float | None = None\n    instructions: str | None = None\n\n@app.post(\"/v1/audio/speech\")\ndef speech(req: SpeechRequest):\n    with tts_lock:\n        audio = synth(req.input)\n    if req.response_format == \"wav\":\n        buf = io.BytesIO()\n        sf.write(buf, audio, 24000, format=\"WAV\", subtype=\"PCM_16\")\n        return Response(content=buf.getvalue(), media_type=\"audio/wav\")\n    pcm = (np.clip(audio, -1, 1) * 32767).astype(np.int16).tobytes()\n    return Response(content=pcm, media_type=\"audio/pcm\")\n\napi_server = uvicorn.Server(uvicorn.Config(app, host=\"0.0.0.0\", port=8000, log_level=\"warning\"))\nthreading.Thread(target=api_server.run, daemon=True).start()\nfor _ in range(30):\n    try:\n        if requests.get(\"http://127.0.0.1:8000/health\", timeout=1).ok:\n            print(\"backend ready\"); break\n    except Exception:\n        time.sleep(1)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T18:46:34.859461Z","iopub.status.idle":"2026-10-06T18:46:34.859921Z","shell.execute_reply.started":"2026-10-06T18:46:34.859739Z","shell.execute_reply":"2026-10-06T18:46:34.859755Z"}},"outputs":[],"execution_count":null},{"id":"18e7a5fe-6f04-453c-bee7-0cbf99951961","cell_type":"code","source":"from IPython.display import Audio, display\nimport soundfile as sf, numpy as np, time\n\nTEXT = \"ሰላም፣ እንኳን ደህና መጡ። እኔ የባንክ ረዳት ነኝ።\"\ncandidates = []\nfor i in range(4):\n    a = synth(TEXT)\n    candidates.append(a)\n    print(\"candidate\", i)\n    display(Audio(a, rate=24000))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T18:46:34.861046Z","iopub.status.idle":"2026-10-06T18:46:34.861327Z","shell.execute_reply.started":"2026-10-06T18:46:34.861198Z","s