{"metadata":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":20316957},{"sourceType":"datasetVersion","sourceId":20316983}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"79ad8297-d4bb-43ab-b00f-28d69786666d","cell_type":"markdown","source":"# Amharic Bank Voice Assistant — clean pipeline\n\nRun the sections **in order, top to bottom**, once per fresh Kaggle session.\n\n**Kaggle settings needed before running:**\n- Accelerator: **GPU T4 x2**\n- Internet: **ON**\n- Secret `HF_TOKEN` added (Add-ons → Secrets)\n- Input dataset `bank-docs` attached (expects `faq/` and `general/` subfolders of `.docx` files)\n\n**Pipeline:** mic → ASR (hohe-asr-amharic) → RAG retrieval (BGE-M3 over bank docs) →\nLLM (Gemma 4 E4B, local via llama.cpp) → TTS (omnivoice-amharic) → spoken answer\n","metadata":{}},{"id":"b6944d79-1175-48f3-a933-b5b9aefb6a6d","cell_type":"markdown","source":"## Section A — Start the LLM server (Gemma 4 E4B via llama.cpp)\n\nBuilds llama.cpp once (skips the ~30 min build if already built this session), downloads the quantized model, and starts a local OpenAI-compatible server.\n\n`-c 8192` is the context window — large enough to hold the system prompt plus retrieved bank-document context plus the user's question without hitting the `exceed_context_size_error` we saw with the old `-c 4096` setting.","metadata":{}},{"id":"a656dd5a-88c4-470f-9ce7-16d79410e47d","cell_type":"code","source":"import os\nimport shutil\n\n# Force a clean wipe of any broken or partial clone/build folders\nfor path in [\n    \"/kaggle/working/llama.cpp/build\",\n    \"/kaggle/working/llama.cpp\",\n]:\n  if os.path.isdir(path):\n    shutil.rmtree(path)\n\nprint(\"Cleaned up old directories. Re-cloning fresh repo...\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T18:50:13.749215Z","iopub.execute_input":"2026-10-06T18:50:13.749474Z","iopub.status.idle":"2026-10-06T18:50:13.955746Z","shell.execute_reply.started":"2026-10-06T18:50:13.749456Z","shell.execute_reply":"2026-10-06T18:50:13.955151Z"}},"outputs":[{"name":"stdout","text":"Cleaned up old directories. Re-cloning fresh repo...\n","output_type":"stream"}],"execution_count":8},{"id":"99dc2702-68cf-4b2d-82ca-d0e30c429cb2","cell_type":"code","source":"import os\nimport shutil\nimport glob\nimport subprocess\nimport time\nimport requests\nfrom huggingface_hub import hf_hub_download\n\ndef sh(cmd, tail=1500):\n    r = subprocess.run(cmd, shell=True, text=True, capture_output=True)\n    print((r.stdout + r.stderr)[-tail:])\n    return r.returncode\n\nBIN = \"/kaggle/working/llama.cpp/build/bin/llama-server\"\nLLAMA_DIR = \"/kaggle/working/llama.cpp\"\n\n# ============================================================\n# 1. Build / validate llama.cpp\n# ============================================================\n\ndef llama_server_works():\n    if not os.path.isfile(BIN):\n        return False\n\n    os.chmod(BIN, os.stat(BIN).st_mode | 0o111)\n    if not os.access(BIN, os.X_OK):\n        return False\n\n    lib_dirs = set()\n    for pattern in [f\"{LLAMA_DIR}/build/**/*.so\", f\"{LLAMA_DIR}/build/**/*.so.*\"]:\n        for lib in glob.glob(pattern, recursive=True):\n            lib_dirs.add(os.path.dirname(lib))\n\n    current_ld = os.environ.get(\"LD_LIBRARY_PATH\", \"\")\n    ld_paths = list(lib_dirs)\n    if current_ld:\n        ld_paths.append(current_ld)\n\n    test_env = {**os.environ, \"LD_LIBRARY_PATH\": \":\".join(ld_paths)}\n\n    result = subprocess.run(\n        [BIN, \"--version\"],\n        env=test_env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        text=True,\n    )\n\n    if result.returncode == 0:\n        os.environ[\"LD_LIBRARY_PATH\"] = \":\".join(ld_paths)\n        print(\"llama-server is valid and executable\")\n        print(result.stdout.strip())\n        return True\n\n    print(\"Existing llama-server is broken:\")\n    print(result.stderr[-1000:])\n    return False\n\nif llama_server_works():\n    print(\"Valid llama.cpp build found, skipping rebuild\")\nelse:\n    print(\"Existing llama.cpp build is missing/broken. Rebuilding...\")\n    if os.path.isdir(f\"{LLAMA_DIR}/build\"):\n        shutil.rmtree(f\"{LLAMA_DIR}/build\")\n\n    if not os.path.isdir(LLAMA_DIR):\n        sh(\"cd /kaggle/working && git clone --depth 1 https://github.com/ggml-org/llama.cpp\")\n\n    rc = sh(\"apt-get update -qq && apt-get install -y -qq gcc-12 g++-12\", 300)\n    assert rc == 0, \"Failed to install GCC\"\n\n    rc = sh(\n        f\"cd {LLAMA_DIR} && \"\n        \"cmake -B build -DCMAKE_BUILD_TYPE=Release -DGGML_CUDA=ON -DGGML_CUDA_NO_VMM=ON \"\n        \"-DCMAKE_CUDA_ARCHITECTURES=75 -DLLAMA_CURL=OFF -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \"\n        \"-DCMAKE_C_COMPILER=gcc-12 -DCMAKE_CXX_COMPILER=g++-12 -DCMAKE_CUDA_HOST_COMPILER=g++-12\",\n        1000,\n    )\n    assert rc == 0, \"CMake configuration failed\"\n\n    rc = sh(f\"cd {LLAMA_DIR} && cmake --build build -j $(nproc) --target llama-server\", 1500)\n    assert rc == 0, \"llama-server build failed\"\n\n    os.chmod(BIN, os.stat(BIN).st_mode | 0o111)\n    assert llama_server_works(), \"llama-server was built but cannot be executed\"\n\n# ============================================================\n# 2. Download Model & Launch Server\n# ============================================================\n\nprint(\"Ensuring Gemma GGUF model is downloaded...\")\nhf_hub_download(\n    repo_id=\"bartowski/google_gemma-4-E4B-it-GGUF\",\n    filename=\"google_gemma-4-E4B-it-Q4_K_M.gguf\",\n)\n\nmodel_paths = glob.glob(\n    \"/root/.cache/huggingface/hub/models--bartowski--google_gemma-4-E4B-it-GGUF/snapshots/*/*.gguf\"\n)\nassert model_paths, \"Model GGUF file not found!\"\nmodel_file = model_paths[0]\nprint(\"Using model file:\", model_file)\n\n# Start server process in background\nserver_process = subprocess.Popen(\n    [\n        BIN,\n        \"-m\", model_file,\n        \"--port\", \"8080\",\n        \"-c\", \"8192\",\n        \"--gpu-layers\", \"99\",\n    ],\n    stdout=open(\"server.log\", \"w\"),\n    stderr=subprocess.STDOUT,\n)\n\nprint(\"Started llama-server, waiting for it to initialize...\")\ntime.sleep(5)\n\nLLM_URL = \"http://127.0.0.1:8080/v1/chat/completions\"","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:41:48.623783Z","iopub.execute_input":"2026-10-06T19:41:48.624135Z","iopub.status.idle":"2026-10-06T19:42:18.352736Z","shell.execute_reply.started":"2026-10-06T19:41:48.624113Z","shell.execute_reply":"2026-10-06T19:42:18.352012Z"}},"outputs":[{"name":"stdout","text":"llama-server is valid and executable\n\nValid llama.cpp build found, skipping rebuild\nEnsuring Gemma GGUF model is downloaded...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"google_gemma-4-E4B-it-Q4_K_M.gguf: reconstructing file:   0%|          |  0.00B / 5.41GB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c810086b161640fb8865903356435a04"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"google_gemma-4-E4B-it-Q4_K_M.gguf: downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c6402baf736f486b9d5f296c19ca9ca6"}},"metadata":{}},{"name":"stdout","text":"Using model file: /root/.cache/huggingface/hub/models--bartowski--google_gemma-4-E4B-it-GGUF/snapshots/029e94146666900b08caf49a3b47b413dfa8ec66/google_gemma-4-E4B-it-Q4_K_M.gguf\nStarted llama-server, waiting for it to initialize...\n","output_type":"stream"}],"execution_count":14},{"id":"0b224c5b-cba5-46d7-9af7-6872dabcdf6c","cell_type":"code","source":"import time\nimport requests\n\nprint(\"Verifying llama-server is responding...\")\nfor i in range(10):\n    try:\n        res = requests.get(\"http://127.0.0.1:8080/v1/models\", timeout=2)\n        if res.status_code == 200:\n            print(\"Server is up and ready!\")\n            break\n    except Exception:\n        pass\n    time.sleep(1)\nelse:\n    print(\"Check failed, but server log says it's listening.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:42:28.920742Z","iopub.execute_input":"2026-10-06T19:42:28.921464Z","iopub.status.idle":"2026-10-06T19:42:28.929207Z","shell.execute_reply.started":"2026-10-06T19:42:28.921436Z","shell.execute_reply":"2026-10-06T19:42:28.928519Z"}},"outputs":[{"name":"stdout","text":"Verifying llama-server is responding...\nServer is up and ready!\n","output_type":"stream"}],"execution_count":15},{"id":"adf2e65a-49ac-4d09-9632-012556a9744c","cell_type":"markdown","source":"## Section B — Load ASR and TTS models\n\nASR: `snapwre/hohe-asr-amharic` (Wav2Vec2 CTC).\nTTS: `gheero-Leyu/amharic-omnivoice-tts`, falls back to `african-low-resource/omnivoice-amharic` if the first one fails to load.\n\n`NUM_STEP = 8` is the diffusion step count we settled on after comparing 32 / 16 / 8 (8 was indistinguishable in listening tests and ~3.4x faster than 32).","metadata":{}},{"id":"78de1c8d-f4a6-4406-9787-2674c78848d7","cell_type":"code","source":"!pip install -q omnivoice soundfile librosa\n\nimport time, torch, numpy as np, librosa, re\n\ntry:\n    from kaggle_secrets import UserSecretsClient\n    from huggingface_hub import login\n    login(UserSecretsClient().get_secret(\"HF_TOKEN\"))\nexcept Exception as e:\n    print(\"no HF token (only a problem if a model below is gated):\", e)\n\nDEV = \"cuda:1\" if torch.cuda.device_count() > 1 else \"cuda:0\"\nprint(\"ASR/TTS device:\", DEV)\n\n# ---------- ASR ----------\nfrom transformers import AutoProcessor, AutoModelForCTC\n\nASR_ID = \"snapwre/hohe-asr-amharic\"\nt = time.time()\nasr_proc = AutoProcessor.from_pretrained(ASR_ID)\nasr_model = AutoModelForCTC.from_pretrained(ASR_ID, dtype=torch.float16).to(DEV).eval()\nprint(f\"ASR loaded in {time.time()-t:.1f}s\")\n\nfe = getattr(asr_proc, \"feature_extractor\", asr_proc)\ntk = getattr(asr_proc, \"tokenizer\", asr_proc)\nAMH_TAG = re.compile(r\"^\\s*\\[[A-Za-z]{2,4}\\]\\s*\")  # strips a stray language tag the model sometimes emits\n\ndef transcribe(wav16):\n    inputs = fe(wav16, sampling_rate=16000, return_tensors=\"pt\")\n    batch = {k: (v.to(DEV, torch.float16) if v.is_floating_point() else v.to(DEV))\n             for k, v in inputs.items()}\n    with torch.no_grad():\n        logits = asr_model(**batch).logits\n    text = tk.batch_decode(logits.argmax(-1))[0]\n    return AMH_TAG.sub(\"\", text).strip()\n\ntranscribe(np.zeros(16000, dtype=np.float32))  # warmup\nt = time.time(); transcribe(np.zeros(16000 * 5, dtype=np.float32))\nprint(f\"ASR on 5s of audio: {time.time()-t:.2f}s\")\n\n# ---------- TTS ----------\nfrom omnivoice import OmniVoice, OmniVoiceGenerationConfig\n\nTTS_ID = \"gheero-Leyu/amharic-omnivoice-tts\"\nt = time.time()\ntry:\n    tts = OmniVoice.from_pretrained(TTS_ID, device_map=DEV, dtype=torch.float16)\nexcept Exception as e:\n    print(\"could not load\", TTS_ID, \"->\", e)\n    TTS_ID = \"african-low-resource/omnivoice-amharic\"\n    print(\"trying\", TTS_ID)\n    tts = OmniVoice.from_pretrained(TTS_ID, device_map=DEV, dtype=torch.float16)\nprint(f\"TTS loaded ({TTS_ID}) in {time.time()-t:.1f}s\")\n\nNUM_STEP = 8  # chosen after comparing 32 / 16 / 8 — see optional Section C below\n\ndef synth(text):\n    audio = tts.generate(\n        text=text, language=\"Amharic\",\n        generation_config=OmniVoiceGenerationConfig(num_step=NUM_STEP, guidance_scale=2.0))\n    a = audio[0]\n    if hasattr(a, \"cpu\"):\n        a = a.float().cpu().numpy()\n    return np.asarray(a, dtype=np.float32).squeeze()\n\nt = time.time(); a = synth(\"ሰላም፣ እንዴት ነህ።\")\nprint(f\"TTS warmup+test: {time.time()-t:.2f}s -> {len(a)/24000:.1f}s of audio\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-06T19:42:37.345115Z","iopub.execute_input":"2026-10-06T19:42:37.345385Z","iopub.status.idle":"2026-10-06T19:43:46.840639Z","shell.execute_reply.started":"2026-10-06T19:42:37.345365Z","shell.execute_reply":"2026-10-06T19:43:46.839929Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m168.5/168.5 kB\u001b[0m \u001b[31m9.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m87.5/87.5 kB\u001b[0m \u001b[31m5.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m75.0/75.0 kB\u001b[0m \u001b[31m4.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hASR/TTS device: cuda:1\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"preprocessor_config.json:   0%|          | 0.00/275 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ba6b532352654a0689bfa6a28f600d9c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/1.86k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ed7c95a7f1af40d5b05b644aafca3000"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/1.97k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"86f1199f101346ce9e202f86a73b5a45"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.json:   0%|          | 0.00/5.60k [00:00<?, ?B/s]"